@@ -441,6 +441,34 @@ configure_ui_library(void)
 /* Optional package setup is a launchd job. Never fork its clients before
  * PID 1 installs the real bootstrap service namespace. */
 
+static void
+list_dir(const char *path)
+{
+    int dir = open(path, O_RDONLY | O_DIRECTORY, 0);
+    if (dir < 0) {
+        printf("Pong init: diag dir %s open errno=%d\n", path, errno);
+        return;
+    }
+    char buf[4096];
+    off_t position = 0;
+    int shown = 0;
+    for (;;) {
+        ssize_t got = getdirentries(dir, buf, sizeof buf, &position);
+        if (got <= 0) break;
+        for (char *at = buf; at < buf + got; ) {
+            struct dirent *entry = (struct dirent *)at;
+            if (!entry->d_reclen) break;
+            if (entry->d_namlen && strcmp(entry->d_name, ".") && strcmp(entry->d_name, "..")) {
+                printf("Pong init: diag dir %s/%s\n", path, entry->d_name);
+                if (++shown >= 16) goto done;
+            }
+            at += entry->d_reclen;
+        }
+    }
+done:
+    close(dir);
+}
