diff --git a/drivers/NativeUfs/PongUfsTransport.cpp b/drivers/NativeUfs/PongUfsTransport.cpp
index cadba81..6530449 100644
--- a/drivers/NativeUfs/PongUfsTransport.cpp
+++ b/drivers/NativeUfs/PongUfsTransport.cpp
@@ -46,6 +46,10 @@ struct UfsHost {
   bool writable = false;
 };
 static UfsHost gHost;
+// The kernel has no support for function-local statics with non-trivial
+// constructors, so the firmware request-list mapping lives here as a raw
+// retained map for the lifetime of the driver.
+static IOMemoryMap *gFirmwareListMap = nullptr;
 static uint32_t gWifiUfsReady;
 static bool gTransportAttempted;
 enum : uint64_t {
@@ -154,18 +158,29 @@ static bool hostBringUp() {
   gRootDiagnostic.cap = read32(gHost.hc, 0);
   gRootDiagnostic.version = read32(gHost.hc, 8);
   recordTransport(kIOReturnNotReady, 15);
-  gRootDiagnostic.stage = "DMA allocation";
-  gHost.dma = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
-    IOOptionBits(kIODirectionInOut) | IOOptionBits(kIOMemoryPhysicallyContiguous) | IOOptionBits(kIOMemoryMapperNone), kDmaBytes, 4096);
+  // liuqin: the controller only reliably reaches the request-list region the loader
+  // itself allocated. ShengUfs on this tablet was reset by a kernel allocation at
+  // 0xf080f000 on the first command and then worked from the firmware's UTRL page
+  // (16 KiB, zeroed by the loader). Reuse that page; the SMMU handover mapping
+  // already covers it.
+  gRootDiagnostic.stage = "firmware request list";
+  uint64_t firmwareList = (uint64_t(read32(gHost.hc, 0x54)) << 32) | read32(gHost.hc, 0x50);
+  if (!firmwareList || (firmwareList & 0xfff)) return transportFailure("firmware request list base");
+  if (!gFirmwareListMap) {
+    IOMemoryDescriptor *memory = IOMemoryDescriptor::withPhysicalAddress(
+        firmwareList, kDmaBytes, kIODirectionInOut);
+    if (!memory) return transportFailure("firmware request list descriptor");
+    gFirmwareListMap = memory->map(kIOMapAnywhere | kIOMapInhibitCache);
+    memory->release();
+  }
+  gHost.phys = firmwareList;
+  gHost.virt = gFirmwareListMap ? reinterpret_cast<uint8_t *>(gFirmwareListMap->getVirtualAddress()) : nullptr;
   gHost.lock = IOLockAlloc();
-  if (!gHost.dma || !gHost.lock) return transportFailure("DMA allocation");
-  gHost.virt = static_cast<uint8_t *>(gHost.dma->getBytesNoCopy());
-  IOByteCount contiguous = 0;
-  gHost.phys = gHost.dma->getPhysicalSegment(0, &contiguous, kIOMemoryMapperNone);
-  gRootDiagnostic.dma = gHost.phys; gRootDiagnostic.contiguous = contiguous;
-  if (!gHost.virt || !gHost.phys || (gHost.phys & 4095) || contiguous < kDmaBytes ||
-      (!(gRootDiagnostic.cap & 0x01000000) && gHost.phys + kDmaBytes > 0x100000000ULL))
-    return transportFailure("DMA address/contiguity");
+  if (!gHost.virt || !gHost.lock) return transportFailure("firmware request list map");
+  gRootDiagnostic.dma = gHost.phys;
+  gRootDiagnostic.contiguous = kDmaBytes;
+  IOLog("PONG_UFS: using the firmware request list at %llx (%u bytes)\n",
+        (unsigned long long)gHost.phys, kDmaBytes);
   bzero(gHost.virt, kDmaBytes); cacheCivac(gHost.virt, kDmaBytes);
   gRootDiagnostic.stage = "quiesce firmware queue";
   const char *why = nullptr;
diff --git a/drivers/NativeUfs/RootTransportLayout.h b/drivers/NativeUfs/RootTransportLayout.h
index f6c926e..3b4c0f1 100644
--- a/drivers/NativeUfs/RootTransportLayout.h
+++ b/drivers/NativeUfs/RootTransportLayout.h
@@ -4,6 +4,6 @@ enum : uint32_t {
   kRspOffset = 512,
   kPrdtOffset = 1024,
   kDataOffset = 8192,
-  kDataMax = 131072,
+  kDataMax = 8192,
   kDmaBytes = kDataOffset + kDataMax,
 };
