+// ------------------------------- QMP PHY --------------------------------
+// Same sequence as Linux qcom-qmp-ufs-phy for v6 (SM8475 tables): programme
+// the SerDes/TX/RX/PCS registers, clear the PCS software reset, start SerDes,
+// then wait for PCS_READY. The second TX/RX lane block sits 0x800 further on.
+static void phyWriteTable (uintptr_t phy, unsigned block, const PongPhyReg *table, unsigned count)
+{
+  for (unsigned index = 0; index < count; ++index)
+    write32 (phy, block + table[index].offset, table[index].value);
+}
+
+static bool phyBringUp (uintptr_t phy)
+{
+  if (!phy) return false;
+  uint32_t readyBefore = read32 (phy, kPhyPcs + kPcsReady);
+  // PCS_POWER_DOWN_CONTROL bit0: set enables the block (Linux clears it when
+  // powering the PHY off).
+  write32 (phy, kPhyPcs + kPcsPowerDown, read32 (phy, kPhyPcs + kPcsPowerDown) | 1U);
+  phyWriteTable (phy, kPhySerdes, kPhyTableSerdes,
+                 sizeof (kPhyTableSerdes) / sizeof (kPhyTableSerdes[0]));
+  phyWriteTable (phy, kPhyTx, kPhyTableTx, sizeof (kPhyTableTx) / sizeof (kPhyTableTx[0]));
+  phyWriteTable (phy, kPhyTx + 0x800, kPhyTableTx, sizeof (kPhyTableTx) / sizeof (kPhyTableTx[0]));
+  phyWriteTable (phy, kPhyRx, kPhyTableRx, sizeof (kPhyTableRx) / sizeof (kPhyTableRx[0]));
+  phyWriteTable (phy, kPhyRx + 0x800, kPhyTableRx, sizeof (kPhyTableRx) / sizeof (kPhyTableRx[0]));
+  phyWriteTable (phy, kPhyPcs, kPhyTablePcs, sizeof (kPhyTablePcs) / sizeof (kPhyTablePcs[0]));
+  // The tablet negotiates HS-G4, so apply that overlay the way the Linux
+  // driver does for its gear overlay tables.
+  phyWriteTable (phy, kPhySerdes, kPhyTableSerdesG4,
+                 sizeof (kPhyTableSerdesG4) / sizeof (kPhyTableSerdesG4[0]));
+  phyWriteTable (phy, kPhyTx, kPhyTableTxG4, sizeof (kPhyTableTxG4) / sizeof (kPhyTableTxG4[0]));
+  phyWriteTable (phy, kPhyTx + 0x800, kPhyTableTxG4, sizeof (kPhyTableTxG4) / sizeof (kPhyTableTxG4[0]));
+  phyWriteTable (phy, kPhyRx, kPhyTableRxG4, sizeof (kPhyTableRxG4) / sizeof (kPhyTableRxG4[0]));
+  phyWriteTable (phy, kPhyRx + 0x800, kPhyTableRxG4, sizeof (kPhyTableRxG4) / sizeof (kPhyTableRxG4[0]));
+  phyWriteTable (phy, kPhyPcs, kPhyTablePcsG4, sizeof (kPhyTablePcsG4) / sizeof (kPhyTablePcsG4[0]));
+  write32 (phy, kPhyPcs + kPcsSwReset, read32 (phy, kPhyPcs + kPcsSwReset) & ~1U);
+  write32 (phy, kPhyPcs + kPcsStart, read32 (phy, kPhyPcs + kPcsStart) | 1U);
+  bool ready = false;
+  for (unsigned spin = 0; spin < 1000; ++spin) {
+    if (read32 (phy, kPhyPcs + kPcsReady) & kPcsReadyBit) { ready = true; break; }
+    IODelay (100);
+  }
+  IOLog ("PONG_UFS: PHY bring-up ready=%u ready=%08x->%08x serdes=%08x tx=%08x rx=%08x\n",
+         ready, readyBefore, read32 (phy, kPhyPcs + kPcsReady),
+         read32 (phy, kPhySerdes), read32 (phy, kPhyTx), read32 (phy, kPhyRx));
+  return ready;
+}
+
+// Same order the working firmware driver uses: pre-link lane selection, link
+// startup, then gear/termination/RXTX power mode.
+static uint32_t uicBringUp (uintptr_t host)
+{
+  uint32_t lanes = 0, gear = 0;
+  uint32_t result = uicCommand (host, kDmeGet, kMibAvailableTxLanes, 0, 0, &lanes);
+  IOLog ("PONG_UFS: UIC available lanes result=%08x lanes=%08x\n", result, lanes);
+  if (!lanes || lanes > 0xfU) lanes = 0xfU;
+  uint32_t tx = uicCommand (host, kDmeSet, kMibActiveTxLanes, 0, lanes, nullptr);
+  uint32_t rx = uicCommand (host, kDmeSet, kMibActiveRxLanes, 0, lanes, nullptr);
+  IOLog ("PONG_UFS: UIC active lanes tx=%08x rx=%08x\n", tx, rx);
+  result = uicCommand (host, kDmeLinkStartup, 0, 0, 0, nullptr);
+  if (result) {
+    uint32_t reset = uicCommand (host, kDmeReset, 0, 0, 0, nullptr);
+    IOLog ("PONG_UFS: UIC DME_RESET result=%08x; retrying link startup\n", reset);
+    IODelay (1000);
+    result = uicCommand (host, kDmeLinkStartup, 0, 0, 0, nullptr);
+  }
+  if (result) return result;
+  uint32_t queried = uicCommand (host, kDmeGet, kMibMaxRxGear, 0, 0, &gear);
+  IOLog ("PONG_UFS: UIC max gear result=%08x gear=%08x\n", queried, gear);
+  if (!gear || gear > 4U) gear = 4U;
+  uint32_t setGear = uicCommand (host, kDmeSet, kMibRxGear, 0, gear, nullptr);
+  setGear |= uicCommand (host, kDmeSet, kMibTxGear, 0, gear, nullptr);
+  setGear |= uicCommand (host, kDmeSet, kMibActiveRxLanes, 0, lanes, nullptr);
+  setGear |= uicCommand (host, kDmeSet, kMibActiveTxLanes, 0, lanes, nullptr);
+  setGear |= uicCommand (host, kDmeSet, kMibRxTermination, 0, 1, nullptr);
+  setGear |= uicCommand (host, kDmeSet, kMibTxTermination, 0, 1, nullptr);
+  setGear |= uicCommand (host, kDmeSet, kMibHsSeries, 0, kUfsHsSeries, nullptr);
+  uint32_t power = uicCommand (host, kDmeSet, kMibPowerMode, 0, kUfsRxtxPowerMode, nullptr);
+  IOLog ("PONG_UFS: UIC gear/lanes set=%08x power=%08x hcs=%08x\n",
+         setGear, power, read32 (host, 0x30));
+  return power;
+}
