     }
-    for (unsigned spin = 0; spin < 1000 && !(read32 (base, 0x30) & kHcsUicReady); ++spin)
-      IODelay (10);
-    uint32_t result = uicLinkStartup (base);
-    for (unsigned spin = 0; spin < 1000 && !(read32 (base, 0x30) & kHcsDevicePresent); ++spin)
-      IODelay (10);
-    IOLog ("PONG_UFS: DME_LINKSTARTUP(%s) result=%08x hcs=%08x dl=%08x->%08x ue=%08x\n",
-           degraded ? "recover" : "absent", result, read32 (base, 0x30),
-           dataLink, read32 (base, kUicErrorDataLink),
-           read32 (base, kInterruptStatus) & kIsUicError);
+    // liuqin: the firmware leaves the UniPro link up. A second LINK_STARTUP on a
+    // live link returns 1 and drives DL 1->0, so when the device is present only
+    // the latched error sources are cleared and the link is left alone. This is
+    // the behaviour the working zizhan tree relies on (it never touches the UIC).
+    uint32_t result = 0;
+    if (read32 (base, 0x30) & kHcsDevicePresent) {
+      IOLog ("PONG_UFS: DME_LINKSTARTUP skipped, device present hcs=%08x dl=%08x ue=%08x\n",
+             read32 (base, 0x30), read32 (base, kUicErrorDataLink),
+             read32 (base, kInterruptStatus) & kIsUicError);
+    } else {
+      for (unsigned spin = 0; spin < 1000 && !(read32 (base, 0x30) & kHcsUicReady); ++spin)
+        IODelay (10);
+      result = uicLinkStartup (base);
+      for (unsigned spin = 0; spin < 1000 && !(read32 (base, 0x30) & kHcsDevicePresent); ++spin)
+        IODelay (10);
+      IOLog ("PONG_UFS: DME_LINKSTARTUP(%s) result=%08x hcs=%08x dl=%08x->%08x ue=%08x\n",
+             degraded ? "recover" : "absent", result, read32 (base, 0x30),
+             dataLink, read32 (base, kUicErrorDataLink),
+             read32 (base, kInterruptStatus) & kIsUicError);
+    }
     status = read32 (base, 0x30);
     interruptStatus = read32 (base, kInterruptStatus);
   }
