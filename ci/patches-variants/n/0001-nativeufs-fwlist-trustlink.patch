-    return transportFailure("DMA address/contiguity");
-  bzero(gHost.virt, kDmaBytes); cacheCivac(gHost.virt, kDmaBytes);
+  if (!gHost.lock) return transportFailure("request list lock");
+  gRootDiagnostic.dma = gHost.phys;
+  gRootDiagnostic.contiguous = kDmaBytes;
+  IOLog("PONG_UFS: using the firmware request list at %llx (%u bytes, device mapped)\n",
+        (unsigned long long)gHost.phys, kDmaBytes);
+  {
+    volatile uint32_t *words = reinterpret_cast<volatile uint32_t *>(gHost.virt);
+    for (uint32_t index = 0; index < kDmaBytes / 4; ++index) words[index] = 0;
+    __asm__ volatile("dsb sy" ::: "memory");
+  }
   gRootDiagnostic.stage = "quiesce firmware queue";
   const char *why = nullptr;
   if (!hostStopQueue(&why)) return transportFailure(why);
@@ -214,23 +235,15 @@ static bool hostBringUp() {
   } // Release before queue commands or storage readiness notifications.
   gRootDiagnostic.stage = "request list start";
   if (!hostStartQueue(&why)) return transportFailure(why);
-  // shim test_ufs probes with a COMMAND UPIU / TEST UNIT READY, never a NOP.
