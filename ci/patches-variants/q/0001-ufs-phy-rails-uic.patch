+// ------------------------------- QMP PHY --------------------------------
+// Dual-window detection: 0x1d80000 (pong's comment) with the v6 grouping, or
+// 0x1d87000 (mainline SM8450) with the v5 grouping.
+static bool phyAnswers (uintptr_t phy)
+{
+  if (!phy) return false;
+  uint32_t saved = read32 (phy, 0x000);
+  write32 (phy, 0x000, 0x5a5a5a5aU);
+  uint32_t value = read32 (phy, 0x000);
+  write32 (phy, 0x000, saved);
+  return value == 0x5a5a5a5aU;
+}
+
+static void phyWriteTable (uintptr_t phy, unsigned block, const PongPhyReg *table, unsigned count)
+{
+  for (unsigned index = 0; index < count; ++index)
+    write32 (phy, block + table[index].offset, table[index].value);
+}
+
+static bool phyBringUpV5 (uintptr_t phy)
+{
+  const unsigned pcs = 0xc00, tx = 0x400, rx = 0x600, ready = 0x180;
+  uint32_t readyBefore = read32 (phy, pcs + ready);
+  write32 (phy, pcs + 0x004, read32 (phy, pcs + 0x004) | 1U);
+  phyWriteTable (phy, 0x000, kPhyTableV5Serdes, sizeof (kPhyTableV5Serdes) / sizeof (kPhyTableV5Serdes[0]));
+  phyWriteTable (phy, tx, kPhyTableV5Tx, sizeof (kPhyTableV5Tx) / sizeof (kPhyTableV5Tx[0]));
+  phyWriteTable (phy, tx + 0x400, kPhyTableV5Tx, sizeof (kPhyTableV5Tx) / sizeof (kPhyTableV5Tx[0]));
+  phyWriteTable (phy, rx, kPhyTableV5Rx, sizeof (kPhyTableV5Rx) / sizeof (kPhyTableV5Rx[0]));
+  phyWriteTable (phy, rx + 0x400, kPhyTableV5Rx, sizeof (kPhyTableV5Rx) / sizeof (kPhyTableV5Rx[0]));
+  phyWriteTable (phy, pcs, kPhyTableV5Pcs, sizeof (kPhyTableV5Pcs) / sizeof (kPhyTableV5Pcs[0]));
+  phyWriteTable (phy, tx, kPhyTableV5TxG4, sizeof (kPhyTableV5TxG4) / sizeof (kPhyTableV5TxG4[0]));
+  phyWriteTable (phy, tx + 0x400, kPhyTableV5TxG4, sizeof (kPhyTableV5TxG4) / sizeof (kPhyTableV5TxG4[0]));
+  phyWriteTable (phy, rx, kPhyTableV5RxG4, sizeof (kPhyTableV5RxG4) / sizeof (kPhyTableV5RxG4[0]));
+  phyWriteTable (phy, rx + 0x400, kPhyTableV5RxG4, sizeof (kPhyTableV5RxG4) / sizeof (kPhyTableV5RxG4[0]));
+  phyWriteTable (phy, pcs, kPhyTableV5PcsG4, sizeof (kPhyTableV5PcsG4) / sizeof (kPhyTableV5PcsG4[0]));
+  write32 (phy, pcs + 0x008, read32 (phy, pcs + 0x008) & ~1U);
+  write32 (phy, pcs + 0x000, read32 (phy, pcs + 0x000) | 1U);
+  bool ok = false;
+  for (unsigned spin = 0; spin < 500; ++spin) {
+    if (read32 (phy, pcs + ready) & 1U) { ok = true; break; }
+    IODelay (200);
+  }
+  IOLog ("PONG_UFS: PHY v5 @%llx ready=%u ready=%08x->%08x serdes=%08x tx=%08x rx=%08x\n",
+         (unsigned long long)phy, ok, readyBefore, read32 (phy, pcs + ready),
+         read32 (phy, 0x000), read32 (phy, tx), read32 (phy, rx));
+  return ok;
+}
+
+static bool phyBringUpV6 (uintptr_t phy)
+{
+  const unsigned pcs = 0x400, tx = 0x1000, rx = 0x1200, ready = 0x1a8;
+  uint32_t readyBefore = read32 (phy, pcs + ready);
+  write32 (phy, pcs + 0x004, read32 (phy, pcs + 0x004) | 1U);
+  phyWriteTable (phy, 0x000, kPhyTableV6Serdes, sizeof (kPhyTableV6Serdes) / sizeof (kPhyTableV6Serdes[0]));
+  phyWriteTable (phy, tx, kPhyTableV6Tx, sizeof (kPhyTableV6Tx) / sizeof (kPhyTableV6Tx[0]));
+  phyWriteTable (phy, tx + 0x800, kPhyTableV6Tx, sizeof (kPhyTableV6Tx) / sizeof (kPhyTableV6Tx[0]));
+  phyWriteTable (phy, rx, kPhyTableV6Rx, sizeof (kPhyTableV6Rx) / sizeof (kPhyTableV6Rx[0]));
+  phyWriteTable (phy, rx + 0x800, kPhyTableV6Rx, sizeof (kPhyTableV6Rx) / sizeof (kPhyTableV6Rx[0]));
+  phyWriteTable (phy, pcs, kPhyTableV6Pcs, sizeof (kPhyTableV6Pcs) / sizeof (kPhyTableV6Pcs[0]));
+  phyWriteTable (phy, 0x000, kPhyTableV6SerdesG4, sizeof (kPhyTableV6SerdesG4) / sizeof (kPhyTableV6SerdesG4[0]));
+  phyWriteTable (phy, tx, kPhyTableV6TxG4, sizeof (kPhyTableV6TxG4) / sizeof (kPhyTableV6TxG4[0]));
+  phyWriteTable (phy, tx + 0x800, kPhyTableV6TxG4, sizeof (kPhyTableV6TxG4) / sizeof (kPhyTableV6TxG4[0]));
+  phyWriteTable (phy, rx, kPhyTableV6RxG4, sizeof (kPhyTableV6RxG4) / sizeof (kPhyTableV6RxG4[0]));
+  phyWriteTable (phy, rx + 0x800, kPhyTableV6RxG4, sizeof (kPhyTableV6RxG4) / sizeof (kPhyTableV6RxG4[0]));
+  phyWriteTable (phy, pcs, kPhyTableV6PcsG4, sizeof (kPhyTableV6PcsG4) / sizeof (kPhyTableV6PcsG4[0]));
+  write32 (phy, pcs + 0x008, read32 (phy, pcs + 0x008) & ~1U);
+  write32 (phy, pcs + 0x000, read32 (phy, pcs + 0x000) | 1U);
+  bool ok = false;
+  for (unsigned spin = 0; spin < 500; ++spin) {
+    if (read32 (phy, pcs + ready) & 1U) { ok = true; break; }
+    IODelay (200);
+  }
+  IOLog ("PONG_UFS: PHY v6 @%llx ready=%u ready=%08x->%08x serdes=%08x tx=%08x rx=%08x\n",
+         (unsigned long long)phy, ok, readyBefore, read32 (phy, pcs + ready),
+         read32 (phy, 0x000), read32 (phy, tx), read32 (phy, rx));
+  return ok;
+}
+
+static bool phyBringUpAuto (uintptr_t primary, uintptr_t alternate)
+{
+  IOLog ("PONG_UFS: PHY probe primary=%d(answers=%d) alternate=%d(answers=%d)\n",
+         primary != 0, phyAnswers (primary), alternate != 0, phyAnswers (alternate));
+  if (phyAnswers (alternate)) return phyBringUpV5 (alternate);
+  if (phyAnswers (primary)) return phyBringUpV6 (primary);
+  IOLog ("PONG_UFS: no PHY window answered the write test\n");
+  return false;
+}
+
+// Full UIC bring-up: lane pre-config, link startup with one DME_RESET retry, then
+// gear/termination/RXTX power mode.
+static uint32_t uicBringUp (uintptr_t host)
+{
+  uint32_t lanes = 0, gear = 0;
+  uint32_t result = uicCommand (host, kDmeGet, kMibAvailableTxLanes, 0, 0, &lanes);
+  IOLog ("PONG_UFS: UIC available lanes result=%08x lanes=%08x\n", result, lanes);
+  if (!lanes || lanes > 0xfU) lanes = 0xfU;
+  uint32_t tx = uicCommand (host, kDmeSet, kMibActiveTxLanes, 0, lanes, nullptr);
+  uint32_t rx = uicCommand (host, kDmeSet, kMibActiveRxLanes, 0, lanes, nullptr);
+  IOLog ("PONG_UFS: UIC active lanes tx=%08x rx=%08x\n", tx, rx);
+  result = uicCommand (host, kDmeLinkStartup, 0, 0, 0, nullptr);
+  if (result) {
+    uint32_t reset = uicCommand (host, kDmeReset, 0, 0, 0, nullptr);
+    IOLog ("PONG_UFS: UIC DME_RESET result=%08x; retrying link startup\n", reset);
+    IODelay (1000);
+    result = uicCommand (host, kDmeLinkStartup, 0, 0, 0, nullptr);
+  }
+  if (result) return result;
+  uint32_t queried = uicCommand (host, kDmeGet, kMibMaxRxGear, 0, 0, &gear);
+  IOLog ("PONG_UFS: UIC max gear result=%08x gear=%08x\n", queried, gear);
+  if (!gear || gear > 4U) gear = 4U;
+  uint32_t setGear = uicCommand (host, kDmeSet, kMibRxGear, 0, gear, nullptr);
+  setGear |= uicCommand (host, kDmeSet, kMibTxGear, 0, gear, nullptr);
+  setGear |= uicCommand (host, kDmeSet, kMibActiveRxLanes, 0, lanes, nullptr);
+  setGear |= uicCommand (host, kDmeSet, kMibActiveTxLanes, 0, lanes, nullptr);
+  setGear |= uicCommand (host, kDmeSet, kMibRxTermination, 0, 1, nullptr);
+  setGear |= uicCommand (host, kDmeSet, kMibTxTermination, 0, 1, nullptr);
+  setGear |= uicCommand (host, kDmeSet, kMibHsSeries, 0, 2, nullptr);
+  uint32_t power = uicCommand (host, kDmeSet, kMibPowerMode, 0, 0x11, nullptr);
+  IOLog ("PONG_UFS: UIC gear/lanes set=%08x power=%08x hcs=%08x\n",
+         setGear, power, read32 (host, 0x30));
+  return power;
 }
 
