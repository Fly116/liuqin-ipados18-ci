diff --git a/drivers/NativeUfs/NativeUfs.cpp b/drivers/NativeUfs/NativeUfs.cpp
index 2bbc068..a306e2f 100644
--- a/drivers/NativeUfs/NativeUfs.cpp
+++ b/drivers/NativeUfs/NativeUfs.cpp
@@ -169,6 +169,78 @@ static uintptr_t mapPhysical (uint64_t physical, uint64_t bytes,
   return mapping ? static_cast<uintptr_t> (mapping->getVirtualAddress ()) : 0;
 }
 
+// Power every rail the liuqin UFS board data names. Nothing in a UFS-only boot
+// votes them; the loader powered them to read the boot image and dropped them
+// before the handover, which is why the QMP PHY registers read back zero (v119-
+// v124) and the first NOP came back with IS.UE set (v131).
+//   PHY   vdda-phy = PM8350B L5 (ldob5), vdda-pll = PM8350C L10 (ldoc10)
+//   device vcc = PM8350B L7 (ldob7), vccq + vddp-ref-clk = PM8350B L9 (ldob9)
+//   PHY GDSC parent supply = the CX level rail (cx.lvl)
+// Same byte layout as PongUsbPhy: mode at resource+8, voltage mV at resource+0,
+// enable at resource+4; level rails take the highest ARC index.
+extern "C" bool pong_rpmh_vote (uint32_t address, uint32_t value);
+extern "C" int qcom_cmd_db_find (const unsigned char *db, unsigned long bytes,
+                                 const char *name, void *out);
+extern "C" int qcom_rpmh_level_index (const void *resource, uint32_t level, uint32_t *index);
+struct QcomRpmhResourceLocal {
+  uint32_t address;
+  uint16_t levels[16];
+  unsigned level_count;
+};
+
+static bool ufsRailVote ()
+{
+  OSSharedPtr<IOMemoryMap> map;
+  uintptr_t db = mapPhysical (0x80860000, 0x20000, map);
+  if (!db) {
+    IOLog ("PONG_UFS: cmd-db map failed; UFS rails not voted\n");
+    return false;
+  }
+  static unsigned char copy[0x20000];
+  memcpy (copy, reinterpret_cast<const void *>(db), sizeof copy);
+  bool ok = true;
+  struct Rail { const char *name; uint32_t mv; };
+  const Rail rails[] = {{"ldob5", 880}, {"ldoc10", 1200}, {"ldob7", 2504}, {"ldob9", 1200}};
+  for (unsigned index = 0; index < sizeof rails / sizeof rails[0]; ++index) {
+    QcomRpmhResourceLocal resource = {};
+    if (qcom_cmd_db_find (copy, sizeof copy, rails[index].name, &resource) ||
+        !pong_rpmh_vote (resource.address + 8, 7) ||
+        !pong_rpmh_vote (resource.address, rails[index].mv) ||
+        !pong_rpmh_vote (resource.address + 4, 1)) {
+      IOLog ("PONG_UFS: UFS rail %s vote failed\n", rails[index].name);
+      ok = false;
+      break;
+    }
+    IOLog ("PONG_UFS: UFS rail %s address=%08x %umV voted\n",
+           rails[index].name, resource.address, rails[index].mv);
+  }
+  if (ok) {
+    for (unsigned index = 0; index < 2; ++index) {
+      const char *name = index ? "lmx.lvl" : "lcx.lvl";
+      QcomRpmhResourceLocal level = {};
+      uint32_t arc = 0;
+      if (qcom_cmd_db_find (copy, sizeof copy, name, &level) ||
+          qcom_rpmh_level_index (&level, 0xffffffffU, &arc) ||
+          !pong_rpmh_vote (level.address, arc)) {
+        IOLog ("PONG_UFS: %s vote failed\n", name);
+        ok = false;
+        break;
+      }
+      IOLog ("PONG_UFS: %s address=%08x arc=%u voted\n", name, level.address, arc);
+    }
+  }
+  if (ok) {
+    QcomRpmhResourceLocal xo = {};
+    if (!qcom_cmd_db_find (copy, sizeof copy, "xo.lvl", &xo) &&
+        pong_rpmh_vote (xo.address, 3)) {
+      IOLog ("PONG_UFS: XO level vote address=%08x=3\n", xo.address);
+    } else {
+      IOLog ("PONG_UFS: XO level vote failed\n");
+    }
+  }
+  return ok;
+}
